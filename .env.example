# Reference only: set these variables in the shell/service environment.
# This file is not loaded automatically.
APISHIELD_ADMIN_HOST=127.0.0.1
APISHIELD_ADMIN_PORT=8002
APISHIELD_GATEWAY_HOST=127.0.0.1
APISHIELD_GATEWAY_PORT=8080
APISHIELD_DB=data/sentinel.db
APISHIELD_HISTORY_LIMIT=20000
APISHIELD_UPSTREAM_HOSTS=127.0.0.1,::1

# Network gateway access requires both certificate and private key files.
# APISHIELD_GATEWAY_CERTFILE=C:/APIShield/certs/gateway-chain.pem
# APISHIELD_GATEWAY_KEYFILE=C:/APIShield/certs/gateway-key.pem
# Optional private CA bundle for HTTPS upstreams and gateway self-checks:
# APISHIELD_CA_FILE=C:/APIShield/certs/trust-bundle.pem
# To follow an adapter, unset APISHIELD_GATEWAY_HOST and set its exact name:
# APISHIELD_GATEWAY_INTERFACE=Ethernet

# Optional random automation token, at least 32 characters. Never commit it.
# APISHIELD_ADMIN_TOKEN=<generate-a-random-token>
# Route policies store variable names; supply actual credentials separately:
# SERVICE_CLIENT_KEY=<generate-a-random-key>
# SERVICE_UPSTREAM_TOKEN=<supply-backend-token>
